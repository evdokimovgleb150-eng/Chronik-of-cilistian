{
  "name": "chroniki-eldorii",
  "version": "1.0.0",
  "private": true,
  "description": "Хроники Эльдории — 2D RPG",
  "scripts": {
    "copy:web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});for(const f of ['index.html','styles.css'])fs.copyFileSync(f,'www/'+f)\"",
    "android:sync": "npm run copy:web && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
